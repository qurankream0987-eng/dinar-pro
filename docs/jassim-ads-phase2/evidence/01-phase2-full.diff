+  assert.ok(Math.abs(active.expiresAt.getTime() - active.startsAt.getTime() - 7 * 86_400_000) < 1000, "window starts at the verified payment");
+  const replay = await deliver("payment.succeeded", { id: good }, { id: ok.id });
