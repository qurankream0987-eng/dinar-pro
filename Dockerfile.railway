FROM node:24-bookworm-slim AS builder

ARG PNPM_VERSION=10.26.1

WORKDIR /app

# Optional managed-cloud trust is mounted for this step only; ordinary CI uses its
# existing system roots. Never copy a session CA or disable TLS verification.
RUN \
  set -eu; \
  if [ -s /run/secrets/proxy_ca ]; then \
    export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca NODE_USE_ENV_PROXY=1; \
  fi; \
  corepack enable \
  && corepack prepare "pnpm@${PNPM_VERSION}" --activate

# Keep dependency installation cached when application source changes. Keep this manifest list in
# sync with the workspace packages in pnpm-workspace.yaml.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY artifacts/dinar/package.json artifacts/dinar/package.json
COPY artifacts/mockup-sandbox/package.json artifacts/mockup-sandbox/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY lib/global/package.json lib/global/package.json
COPY lib/integrations-openai-ai-server/package.json lib/integrations-openai-ai-server/package.json
COPY scripts/package.json scripts/package.json

RUN \
  set -eu; \
  if [ -s /run/secrets/proxy_ca ]; then \
    export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca NODE_USE_ENV_PROXY=1; \
  fi; \
  pnpm install --frozen-lockfile

# Managed worktrees may have private 0700/0600 source modes. Preserve those modes
# while making the runtime user their owner; do not rely on a world-readable clone.
COPY --chown=node:node . .

# Public, build-time web settings (not secrets): Railway passes a service variable to the build
# only when it is declared here. The Google client id is a public identifier.
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
# Map style (owner-approved provider, e.g. MapTiler). A public, domain-restricted key; https only.
ARG VITE_DINAR_MAP_STYLE_URL=""
ENV VITE_DINAR_MAP_STYLE_URL=$VITE_DINAR_MAP_STYLE_URL

RUN pnpm --filter @workspace/dinar run build \
  && pnpm --filter @workspace/api-server run build

# Keep compilers, test runners and frontend tooling out of the runtime dependency tree.
# All artifacts are built above; frozen offline pruning cannot fetch an unreviewed package.
RUN CI=true pnpm install --prod --frozen-lockfile --offline \
  && pnpm store prune

FROM node:24-bookworm-slim AS runtime

WORKDIR /app
COPY --from=builder --chown=node:node /app/ /app/

ENV NODE_ENV=production
ENV DINAR_WEB_DIST=/app/artifacts/dinar/dist/public

# /api/readyz resolves the checked-in migration journal relative to process.cwd().
WORKDIR /app/artifacts/api-server

USER node

CMD ["node", "--enable-source-maps", "/app/artifacts/api-server/dist/index.mjs"]
